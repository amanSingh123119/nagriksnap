# ==============================================================================
# NagrikSnap Production Environment Configuration Template
# Copy this file to backend/.env and replace placeholders with live credentials.
# ==============================================================================

# Application Environment Mode: 'production' or 'development'
APP_ENV=production

# Server Port (default 8000)
PORT=8000

# ------------------------------------------------------------------------------
# 1. Database Persistence (PostgreSQL / Neon Cloud)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_j8nlwN4PaWIb@ep-steep-frost-akscnpak-pooler.c-3.us-west-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Evidence Object Storage (AWS S3 / Cloudflare R2 / MinIO)
# Set to 's3' for production S3 buckets, or 'local' for container filesystem storage
# ------------------------------------------------------------------------------
EVIDENCE_STORAGE_MODE=local
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=nagriksnap-evidence-prod
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com  # Optional: For Cloudflare R2

# ------------------------------------------------------------------------------
# 3. AI Categorization & Jan Sevak Chatbot (Groq Llama 3.1)
# Free API key at https://console.groq.com
# ------------------------------------------------------------------------------
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 4. SMS Gateways (Twilio or Fast2SMS)
# ------------------------------------------------------------------------------
# Fast2SMS (India): https://www.fast2sms.com
FAST2SMS_API_KEY=

# Twilio (International / US / India): https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# ------------------------------------------------------------------------------
# 5. Security, Sessions, and CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed HTTPS domain origins
ALLOWED_ORIGINS=https://nagriksnap.org,https://www.nagriksnap.org

# Session Time-To-Live in seconds (e.g. 28800 = 8 hours)
SESSION_TTL_SECONDS=28800

# Central Administrator Account (Provisioned out-of-band)
ADMIN_USERNAME=central_admin
# Generate hash using: python -c "from main import hash_password; print(hash_password('YourStrongPass123!'))"
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$p9876543210$...

# ------------------------------------------------------------------------------
# 6. SMTP Email Notifications (Optional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="NagrikSnap Alerts <no-reply@nagriksnap.org>"
