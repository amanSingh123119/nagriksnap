# Copy this file to .env locally. Never commit .env or real secrets.
# Only include origins that actually serve your frontend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_BYTES=5242880
# Server-side bearer session lifetime; default 8 hours (300-604800 seconds).
SESSION_TTL_SECONDS=28800

# Optional AI/SMS providers. Keep keys private.
GROQ_API_KEY=
FAST2SMS_API_KEY=

# Optional administrator provisioned out-of-band. Do not use a default password.
# Generate a hash using argon2-cffi and set ADMIN_PASSWORD_HASH.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Evidence storage. Local is development-only; S3 mode requires a private bucket.
EVIDENCE_STORAGE_MODE=local
S3_BUCKET=
S3_REGION=ap-south-1
# Optional for S3-compatible providers such as Cloudflare R2 or MinIO; leave blank for AWS S3.
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMTP email delivery (required for login notices and email OTP password reset).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=NagrikSnap <no-reply@example.com>
